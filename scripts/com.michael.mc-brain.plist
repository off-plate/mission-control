<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac half of the Claude brain: answers long dictations from Mission
     Control by asking `claude -p` on his own Claude subscription.

     One long-lived process, not a timer: a Supabase refresh token rotates, and
     overlapping timer runs spend each other's token (the Obsidian job lost two
     days to that). KeepAlive restarts it if it crashes. It exits quietly, and
     is NOT restarted, when it is not signed in.

     It does not keep the Mac awake. A sleeping Mac stops the heartbeat within
     90 seconds and the app answers with Gemini instead.

     Sign in once before loading this:
       cd "/Users/michaelflorianrvltdigital/Claude Helpers/Mission Control"
       node tools/claude-brain.mjs --login

     Install:
       cp "/Users/michaelflorianrvltdigital/Claude Helpers/Mission Control/scripts/com.michael.mc-brain.plist" ~/Library/LaunchAgents/
       launchctl unload ~/Library/LaunchAgents/com.michael.mc-brain.plist 2>/dev/null
       launchctl load ~/Library/LaunchAgents/com.michael.mc-brain.plist

     Check it:  node tools/claude-brain.mjs --status
     Stop it:   launchctl unload ~/Library/LaunchAgents/com.michael.mc-brain.plist
     What it did (ids, models, seconds, cost; never what he said): ~/.mc-brain/brain.log -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.michael.mc-brain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>tools/claude-brain.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/michaelflorianrvltdigital/Claude Helpers/Mission Control</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/mc-brain.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mc-brain.error.log</string>
</dict>
</plist>
