{
  "manifest_version": 3,
  "name": "MyMind for Mission Control",
  "version": "1.0.0",
  "description": "Save the page, a link, a picture or selected text into Mission Control > MyMind.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to MyMind" },
  "options_page": "options.html",
  "commands": {
    "quick-save": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save this page to MyMind"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
